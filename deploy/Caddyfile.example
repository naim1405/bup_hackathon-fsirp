# Point hackathon.bebsapati.com to VPS 167.99.226.149.
# Caddy obtains and renews TLS certificates automatically.
hackathon.bebsapati.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8001 {
        # Flush streaming responses such as the SSE endpoint without buffering.
        flush_interval -1
    }
}
