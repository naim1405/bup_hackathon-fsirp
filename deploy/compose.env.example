# Copy this file to the repository root as .env to override Compose defaults.
# It contains development/demo settings only; do not add secrets here.
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused
SIMULATOR_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
SIMULATOR_TIMEOUT_SECONDS=8
# Keep false unless writes are intentionally enabled in a trusted, access-controlled environment.
SIMULATOR_WRITES_ENABLED=false
BACKEND_API_URL=http://backend:8001
